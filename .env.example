# ============================================================================
# LORD AI — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# On Vercel, add these as Environment Variables (Project → Settings → Environment Variables).
#
# Client-side variables (prefixed VITE_) are inlined into the browser bundle,
# so they MUST be public keys only. NEVER put a secret behind a VITE_ prefix.
# ============================================================================

# ---- Supabase (Client) -----------------------------------------------------
# Public / publishable Supabase URL and anon key. Safe to expose to the browser.
# Found in: Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Optional alias; VITE_SUPABASE_PUBLISHABLE_KEY takes precedence.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (Server) -----------------------------------------------------
# Used by server routes / server functions and by the AI auth middleware.
# These read process.env at request time (never bundled into the client).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Optional alias; SUPABASE_PUBLISHABLE_KEY takes precedence.
# SUPABASE_ANON_KEY=your-anon-key

# ---- OpenRouter (Server only) -----------------------------------------------
# Secret API key for the multi-provider LORD AI gateway. Stays server-side;
# never expose to the browser. Get one at https://openrouter.ai/keys
# At least one of the three provider keys below is required for /api/chat.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional live web search for the chat "Sources" toggle. Server only; never
# prefix this with VITE_. Get a key at https://app.tavily.com/.
TAVILY_API_KEY=your_tavily_api_key_here

# Optional OpenRouter HTTP headers (used for usage attribution on openrouter.ai).
# OPENROUTER_REFERER=https://lordai.app
# OPENROUTER_TITLE=LordAI

# ---- Gemini (Server only) ---------------------------------------------------
# Google Gemini API key. When set, Gemini is available as a routing target
# (used first in `balanced` and `fast` modes). Get one at https://aipool.google.
# GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- OpenAI (Server only) ---------------------------------------------------
# OpenAI API key. When set, OpenAI is available as a routing target
# (used first in `quality`/`reasoning` and `coding` modes).
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudflare Workers AI (Server only) ------------------------------------
# Cloudflare account id and API token for the dedicated Cloudflare image
# generation provider (Workers AI). When both are set, users can select
# "cloudflare" as their image provider; the gateway calls the Workers AI REST
# API directly. Create a token with "Account AI" permissions at
# https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Optional: override the default Workers AI image model
# (default: @cf/black-forest-labs/flux-1-schnell)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Provider timeouts (optional). Override the defaults (45s each) if needed.
# GEMINI_TIMEOUT_MS=45000
# OPENROUTER_TIMEOUT_MS=45000
# OPENAI_TIMEOUT_MS=45000

# ---- Optional / Tooling ----------------------------------------------------
# Supabase project id (used by Supabase CLI / Lovable Cloud tooling).
# SUPABASE_PROJECT_ID=your-project-ref
# VITE_SUPABASE_PROJECT_ID=your-project-ref

# Supabase service role key — bypasses RLS. Only needed if you use the
# server-side admin client (src/integrations/supabase/client.server.ts).
# Treat as a SECRET. Keep server-side only.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase access token for the Supabase CLI (linking / migrations).
# Not used by the running app — keep local only.
# SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Public HTTPS origin for the deployed LORD server used by native Android builds.
# Required because the app UI is bundled locally and cannot serve /api routes.
# This is an origin, not a secret. Never put provider keys or server credentials here.
# VITE_API_BASE_URL=https://your-lord-deployment.example

# ---- LORD Pro / Razorpay (server only; TEST MODE) --------------------------
# Create matching monthly and yearly plans in the Razorpay test dashboard.
# Prices below are what the UI displays; set the Razorpay plans to ₹99/month
# and ₹990/year (or update both values and plan amounts together).
LORD_PRO_MONTHLY_PRICE_INR=99
LORD_PRO_YEARLY_PRICE_INR=990
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
RAZORPAY_MONTHLY_PLAN_ID=plan_your_monthly_plan
RAZORPAY_YEARLY_PLAN_ID=plan_your_yearly_plan

# ---- PhonePe Pro one-time checkout (server only; SANDBOX) ------------------
# Create sandbox API credentials in the PhonePe PG dashboard. Never use VITE_.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=your_phonepe_sandbox_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_sandbox_client_secret
PHONEPE_CLIENT_VERSION=1
# Public HTTPS origin used to return customers to the authenticated upgrade page.
APP_BASE_URL=https://your-lord-deployment.example

# Lifetime Pro grants require the immutable auth.users UUID paired with the
# matching verified email. Populate these only after confirming IDs in Supabase.
# Entries are comma-separated UUID:email pairs. An email alone never grants Pro.
LORD_LIFETIME_PRO_USERS=uuid-for-nagasatwik145:nagasatwik145@gmail.com,uuid-for-djahnavi451:djahnavi451@gmail.com,uuid-for-inf1nity3smart:inf1nity3smart@gmail.com

# Optional UUID allowlist for the server-authorized aggregate operations dashboard.
# LORD_ADMIN_USER_IDS=admin-user-uuid,another-admin-user-uuid
